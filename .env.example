# JuristAI environment reference.
# Copy to .env for local work. Never commit a filled-in copy: production
# values live only in Render's environment. Empty = unset.
# (*) marks what the server needs to start at all.

# ── Core ─────────────────────────────────────────────────────────────────────
PORT=3000
LOG_LEVEL=info
SESSION_SECRET=                 # (*) long random string; signs session cookies
JWT_SECRET=                     # (*) fallback session secret; keep both set
CORS_ORIGINS=                   # comma-separated extra origins
APP_URL=                        # public base URL (OAuth redirects, links)
PUBLIC_APP_URL=                 # Workspace invitation links
DASHBOARD_URL=                  # dashboard link in Telegram notifications
WEBHOOK_DOMAIN=                 # Telegram webhook host when not on Render
MASTER_2FA=                     # off = disable master Telegram 2FA
PAYMENTS_ENABLED=               # keep unset: no payment provider yet (DECISIONS D-2)
BOOT_ALLOW_PARTIAL=             # true = start even if boot migrations fail (emergency only)
MASTER_BOOTSTRAP_PASSWORD=      # creates the first master on an empty DB; 12+ chars, not a published one

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=                   # (*) Postgres / Supabase connection string
DATABASE_CA_CERT=               # PEM; enables verified TLS
PGSSL=                          # disable = no TLS (local Postgres)
DB_POOL_MAX=15
VERSIONED_MIGRATIONS=           # off = skip migrations/*.sql
ALLOW_EMBED_MIGRATION=          # true = allow dropping/recreating the embedding column

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=             # (*) legal bot
TELEGRAM_WEBHOOK_SECRET=        # optional; derived from the bot token when unset
REG_BOT_TOKEN=                  # registration / OTP / 2FA bot
ADMIN_TELEGRAM_ID=
REQUIRED_CHANNEL=
TELEGRAM_CHANNEL_GATE_ENABLED=
CHANNEL_GRACE_DAYS=0
INSTAGRAM_URL=
TG_PAID_ANSWER_STARS=1          # price of a pack for NEW invoices (see docs/finance/tariffs-v2-report.md)
TG_PAID_ANSWER_CREDITS=4        # answers per pack for NEW invoices
TG_ANSWER_RESERVATION_TTL_MIN=
# tariffs v2 (docs/tariffs-v2.md); the daily free Telegram answers are retired
TARIFF_RESERVATION_TTL_MIN=30   # an abandoned reservation stops counting after this
DOC_TICKET_SECRET=              # HMAC key of document tickets (else SESSION_SECRET / JWT_SECRET)
TARIFF_COST_MODEL=              # JSON cost model for discount floors (docs/tariffs-v2.md §9); default = planning budgets
# Telegram test account (src/bot/test-account.js): no daily limit / credits for
# one ordinary account, by its Telegram user id; own budget; ends 48 h after SINCE
TG_TEST_ACCOUNT_USER_ID=        # digits, the id linked in admins.telegram_user_id
TG_TEST_ACCOUNT_SINCE=          # ISO start time, e.g. 2026-10-04T12:00:00+05:00
TG_TEST_ACCOUNT_HOURS=          # shorter window if wanted (max 48)
TG_TEST_ACCOUNT_BUDGET_USD=5
TG_TEST_UNKNOWN_CALL_USD=0.05   # price assumed for a call of unknown cost
TG_TEST_ACCOUNT=                # off = disable at once
AGENT_AUTO_ANSWER=
AGENT_ESCALATE_WEAK=
AGENT_MAX_CLARIFY=
MODEL_TELEGRAM=                 # e.g. voicelab/aisha-comet

# ── LLM providers and models ─────────────────────────────────────────────────
GPT_API_KEY=                    # OpenAI
OPENAI_API_KEY=                 # alias read by embeddings / hybrid pipeline
GEMINI_API_KEY=
MODEL_PREMIUM=                  # default gpt-6-sol
MODEL_STANDARD=                 # default gpt-6-sol
MODEL_CHEAP=                    # default gpt-6-luna
MODEL_CHAT=                     # default gpt-6-luna
MODEL_VISION=
OPINION_MODEL=
OPINION_MODEL_STAFF=
OPINION_MAX_REFS=
OPINION_LEX_BUDGET_CHARS=
OPINION_REF_WINDOWS=
LLM_DAILY_BUDGET_USD=
AI_TIMEOUT_MS=180000            # deadline for one AI call
AI_STREAM_TIMEOUT_MS=300000     # deadline for a streamed answer
# per user request (docs/ai-routing.md): calls and time hold even when prices are unknown
AI_REQUEST_MAX_CALLS=30
AI_REQUEST_ESSENTIAL_RESERVE=6  # extra calls kept for answer / cross-check / claim check
AI_REQUEST_MAX_MS=120000
AI_REQUEST_MAX_COST_USD=0.25
# circuit breaker (src/ai/provider-health.js)
AI_BREAKER_PERMANENT_MS=600000  # after a 401/402/403/404/quota error
AI_BREAKER_TRANSIENT_MS=30000
AI_BREAKER_TRANSIENT_THRESHOLD=3
AI_PRICE_OVERRIDES=             # JSON {"model":{"in":x,"out":y}} USD/1M, owner-confirmed prices (e.g. Gemini embedding)
SHORT_FETCH_TIMEOUT_MS=60000    # screening, Telegram file downloads
OCR_TIMEOUT_MS=90000
STORAGE_TIMEOUT_MS=60000        # Supabase Storage
LLM_DAILY_CEILING_USD=
LLM_MONTHLY_CEILING_USD=
HYBRID_PIPELINE=
ALLOW_WEB_SEARCH=
TAVILY_API_KEY=

# ── VoiceLab ─────────────────────────────────────────────────────────────────
LLM_PROVIDER=                   # voicelab = route chat lanes to VoiceLab
VOICELAB_API_KEY=
VOICELAB_BASE_URL=
VOICELAB_TIMEOUT_MS=
VOICELAB_FALLBACK=              # false = no fallback to the previous provider
VOICELAB_LANES=
VOICELAB_MODEL_CHEAP=           # also _STANDARD, _PREMIUM, _VISION
VOICELAB_PRICES=                # JSON, USD per 1M tokens
VOICELAB_MIN_MAX_TOKENS=         # optional floor for max_tokens (off; a floor did not stop Orbit's empty answers)
LEX_PLANNER_LANE=                # cheap (default) | standard: model lane of the lex.uz query plan
VOICELAB_CREDIT_USD=            # USD per VoiceLab credit (default 90/1200000 = 0.000075, owner's purchase)
VOICELAB_STT=                   # off = no speech-to-text
VOICELAB_STT_LANGUAGE=
VOICELAB_TTS_VOICE_ID=          # set to answer voice questions with voice
VOICELAB_TTS_LANGUAGE=
VOICELAB_TTS_SPEED=
VOICELAB_TTS_MAX_CHARS=

# ── RAG, embeddings, verification ────────────────────────────────────────────
HF_TOKEN=                       # HuggingFace embeddings + reranker
EMBED_PROVIDER=                 # force: huggingface | gemini | openai
GEMINI_EMBED_DIMS=
RERANKER_MODEL=
RERANKER=                       # off = keyword re-rank only, no HF calls (request marked degraded)
RERANK_MAX_CANDIDATES=12
RERANK_CONCURRENCY=4
REEMBED_BATCH=
RAG_CORRECTIVE_MODE=            # cheap (default) | standard | off: retrieval relevance grader
ANSWER_CACHE=                   # off = disable the answer cache
SOURCE_SUGGESTIONS=
COVERAGE_MIN_LAW_CHUNKS=
LEX_AI_QUERY_PLANNER=
LEX_CROSSCHECK_EVERY_ANSWER=
LEX_DOCUMENT_CACHE_TTL_MS=
CORPUS_FRESHNESS=               # off = stop the weekly (Sunday 03:00 Tashkent) lex.uz re-check of corpus acts
ANSWER_VERIFICATION_LIVE_FETCH=
ANSWER_VERIFICATION_TIMEOUT_MS=
JUSTIFY_URL=
JUSTIFY_TENANT=
E_ADVOCAT_ENABLED=

# ── Hermes shadow evaluation ─────────────────────────────────────────────────
HERMES_SHADOW_ENABLED=
HERMES_SHADOW_URL=
HERMES_SHADOW_API_KEY=
HERMES_SHADOW_MODEL=
HERMES_SHADOW_PRICING_MODEL=
HERMES_SHADOW_SAMPLE_RATE=
HERMES_SHADOW_TIMEOUT_MS=
HERMES_SHADOW_MAX_ATTEMPTS=

# ── Tariffs ──────────────────────────────────────────────────────────────────
FAIR_USE_SILVER=15
FAIR_USE_GOLD=30
FAIR_USE_PLATINUM=70
CREDITS_SILVER=9
CREDITS_GOLD=17
CREDITS_PLATINUM=42
DRAFTS_SILVER=22
DRAFTS_GOLD=50
DRAFTS_PLATINUM=125
OCR_PAGES_SILVER=20
OCR_PAGES_GOLD=50
OCR_PAGES_PLATINUM=100
UZS_PER_USD=11980
REBATE_THRESHOLD=0.75
MAX_USER_TEMPLATES=30

# ── Auth and email ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTH_ENABLED=            # true = show and accept Google sign-in (off by default)
SMTP_HOST=                      # email codes also need nodemailer, not installed yet
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_DEV_LOG_CODES=            # true = print email codes to the log (local development only)

# ── Supabase (Workspace) ─────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWT_SIGNING_SECRET=
SUPABASE_JWT_PRIVATE_KEY=
SUPABASE_JWT_KEY_ID=
SUPABASE_JWT_ALGORITHM=
